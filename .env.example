# Copy to .env and adjust. All settings documented in backend/app/config.py.

# --- storage ---------------------------------------------------------------
POSTGRES_PASSWORD=copytrader
DATABASE_URL=postgresql+asyncpg://copytrader:copytrader@localhost:5432/copytrader
REDIS_URL=redis://localhost:6379/0

# --- solana RPC ------------------------------------------------------------
# Public mainnet endpoints rate-limit hard; a provider endpoint (Helius,
# Triton, QuickNode...) is strongly recommended for real ingestion volume.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
RPC_REQUESTS_PER_SECOND=8
# Hard daily cap on RPC calls (= provider credits, e.g. Helius). Shared by
# all services via Redis; once spent, non-critical calls pause until the
# next UTC day. This is your main line of defense against runaway spend, so
# it defaults to a REAL cap (150k), not unlimited. On a 10M/month plan
# (~333k/day) 150k main + 30k priority ≈ 5.4M/month with headroom.
# Set 0 ONLY to deliberately opt out of the cap (unlimited — not recommended).
RPC_DAILY_CREDIT_BUDGET=150000
# SEPARATE cap for calls that skip the line above (live execution, the
# followed-wallet priority lane, rug-check probes) - they never wait behind
# the main budget, but they are NOT unbounded: this is their own real daily
# ceiling. Total worst-case daily spend = the two limits added together.
RPC_PRIORITY_DAILY_CREDIT_BUDGET=30000

# --- ingestion -------------------------------------------------------------
# JSON list; see Dex enum in backend/app/ingestion/events.py
ENABLED_DEXES=["pumpfun","pumpswap","raydium_amm","raydium_clmm","raydium_cpmm","orca_whirlpool","jupiter"]
INGEST_STORE_RAW=false
# Ingest buffer cap. The stream auto-drops the OLDEST entries past this size,
# so a budget-limited writer always works the freshest ~30-60s of the
# firehose. Keep this small: a large value makes the writer burn credits
# grinding through a stale backlog one getTransaction at a time.
INGEST_STREAM_MAXLEN=10000

# --- enrichment ------------------------------------------------------------
TOKEN_SNAPSHOT_INTERVAL_SECONDS=60
MARKET_SNAPSHOT_INTERVAL_SECONDS=60
HOLDERS_ENABLED=false

# --- copy trading (Phase 3) ------------------------------------------------
# OFF by default. Enabling with COPY_MODE=paper runs the full decision +
# simulated-fill pipeline without touching the chain (recommended first).
COPY_ENABLED=false
COPY_MODE=paper
# LIVE trading requires COPY_MODE=live AND a DEDICATED trading wallet secret
# (base58 or JSON byte array; NEVER a main wallet). Leave unset for paper.
TRADING_WALLET_SECRET=
# Shared secret protecting resume/approval endpoints. Unset = those endpoints
# are refused (emergency-stop always works without it).
ADMIN_TOKEN=
COPY_FIXED_SOL=0.05
COPY_MAX_POSITION_SOL=0.5
COPY_MAX_EXPOSURE_SOL=2.0
COPY_DAILY_LOSS_LIMIT_SOL=1.0
COPY_MIN_CONFIDENCE=60
COPY_MAX_RISK=70
COPY_SLIPPAGE_BPS=300
COPY_APPROVAL_MODE=false
# A token whose market cap is unknown (supply not yet backfilled) passes the
# mcap gate by default - the liquidity floor is the real thin-token guard.
# Set true to require a known mcap instead.
COPY_REQUIRE_MARKET_CAP=false

# --- ingestion priority lane -------------------------------------------------
# Followed (starred + auto-followed) wallets get dedicated on-chain
# subscriptions so their trades are fetched within seconds instead of
# competing with the sampled firehose for a slot in the RPC budget.
FOLLOW_LANE_ENABLED=true
FOLLOW_LANE_MAX=50
FOLLOW_LANE_REFRESH_SECONDS=60
INGEST_PRIORITY_MAXLEN=5000

# --- wallet vetting (fake-wallet / ring detection) ---------------------------
# Flags wallets funded by a shared private source, trading with a repeating
# small cast of counterparties, or profiting mainly on tokens they/their
# funder created. Suspicious verdicts block AUTO-follow only - a wallet you
# manually starred keeps trading, with a loud warning.
VETTING_ENABLED=true
VETTING_BLOCK_SUSPICIOUS=true

# --- token rug-risk engine ---------------------------------------------------
# Pre-copy structural risk assessment: mint/freeze authority, holder and LP
# concentration, deployer history, volume authenticity. Hard filters (active
# authorities, extreme concentration) block regardless of score; the 0-100
# composite gates the rest. Outcome learning tunes soft weights only - it can
# never loosen hard filters. All knobs in backend/app/config.py (rug_*).
RUG_CHECK_ENABLED=true
RUG_MAX_SCORE=60
# Fail closed: block when on-chain authority state cannot be determined.
RUG_FAIL_CLOSED=true

# --- dashboard / API auth ---------------------------------------------------
# Random secret signing JWTs issued on login; generate with
# `python3 -c "import secrets; print(secrets.token_hex(32))"` and keep it
# private. Changing it invalidates all existing sessions.
JWT_SECRET=dev-insecure-change-me
ADMIN_USERNAME=admin
# Bcrypt hash of the dashboard admin password, NOT the plaintext password.
# MUST be wrapped in single quotes: bcrypt hashes contain `$`, and docker
# compose expands `$name` in .env values as variable references — unquoted,
# the salt is silently mangled and login always fails. Generate with:
# docker compose exec -T api python -c "from app.auth.security import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=''

# --- frontend ----------------------------------------------------------------
# The browser (not the server) calls this URL, so it must be reachable from
# wherever you load the dashboard - e.g. http://YOUR_DROPLET_IP:8000, not
# localhost or a Docker service name. Baked into the JS bundle at build time:
# changing this requires `docker compose up -d --build frontend`.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- logging / monitoring --------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_PORT=9100
