# Copy to .env and adjust. All settings documented in backend/app/config.py.

# --- storage ---------------------------------------------------------------
POSTGRES_PASSWORD=copytrader
DATABASE_URL=postgresql+asyncpg://copytrader:copytrader@localhost:5432/copytrader
REDIS_URL=redis://localhost:6379/0

# --- solana RPC ------------------------------------------------------------
# Public mainnet endpoints rate-limit hard; a provider endpoint (Helius,
# Triton, QuickNode...) is strongly recommended for real ingestion volume.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
RPC_REQUESTS_PER_SECOND=8

# --- ingestion -------------------------------------------------------------
# JSON list; see Dex enum in backend/app/ingestion/events.py
ENABLED_DEXES=["pumpfun","pumpswap","raydium_amm","raydium_clmm","raydium_cpmm","orca_whirlpool","jupiter"]
INGEST_STORE_RAW=false

# --- enrichment ------------------------------------------------------------
TOKEN_SNAPSHOT_INTERVAL_SECONDS=60
MARKET_SNAPSHOT_INTERVAL_SECONDS=60
HOLDERS_ENABLED=false

# --- copy trading (Phase 3) ------------------------------------------------
# OFF by default. Enabling with COPY_MODE=paper runs the full decision +
# simulated-fill pipeline without touching the chain (recommended first).
COPY_ENABLED=false
COPY_MODE=paper
# LIVE trading requires COPY_MODE=live AND a DEDICATED trading wallet secret
# (base58 or JSON byte array; NEVER a main wallet). Leave unset for paper.
TRADING_WALLET_SECRET=
# Shared secret protecting resume/approval endpoints. Unset = those endpoints
# are refused (emergency-stop always works without it).
ADMIN_TOKEN=
COPY_FIXED_SOL=0.05
COPY_MAX_POSITION_SOL=0.5
COPY_MAX_EXPOSURE_SOL=2.0
COPY_DAILY_LOSS_LIMIT_SOL=1.0
COPY_MIN_CONFIDENCE=60
COPY_MAX_RISK=70
COPY_SLIPPAGE_BPS=300
COPY_APPROVAL_MODE=false

# --- dashboard / API auth ---------------------------------------------------
# Random secret signing JWTs issued on login; generate with
# `python3 -c "import secrets; print(secrets.token_hex(32))"` and keep it
# private. Changing it invalidates all existing sessions.
JWT_SECRET=dev-insecure-change-me
ADMIN_USERNAME=admin
# Bcrypt hash of the dashboard admin password, NOT the plaintext password.
# Generate with:
# docker compose exec api python -c "from app.auth.security import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=

# --- logging / monitoring --------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_PORT=9100
